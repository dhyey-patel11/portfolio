---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { portfolio } from '../../data/load';
export function getStaticPaths(){return portfolio.projects.map((project:any)=>({params:{slug:project.slug},props:{project}}));} const {project}=Astro.props;
---
<BaseLayout title={`${project.title} | ${portfolio.person.name}`} description={project.summary}><article class="container max-w-6xl py-16 sm:py-20"><a class="text-sm text-[#d2a04a]" href="/projects">← Back to projects</a><header class="project-detail-head mt-9"><div><p class="eyebrow">PROJECT // {project.dates}</p><h1 class="heading mt-3 text-5xl font-bold leading-tight sm:text-6xl">{project.title}</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-[#cdd2ce]">{project.summary}</p><div class="mt-6 flex flex-wrap gap-2">{project.tags.map((t:string)=><span class="tag">{t}</span>)}</div></div><div class="detail-hero">{project.heroImage?<img src={project.heroImage} alt={`${project.title} project`}/>:<div class="visual-placeholder tall"><span class="scan-line"></span><span>PROJECT IMAGE // ADD LATER</span><div class="node-map"><i></i><i></i><i></i></div></div>}</div></header><section class="project-story mt-16"><div class="story-heading"><p class="eyebrow">BUILD // IMPLEMENTATION</p><h2 class="heading mt-2 text-4xl font-bold">What I built</h2><p class="mt-3 muted">The main engineering work and measurable outcomes from this project.</p></div><ul class="project-accomplishments mt-8">{project.bullets.map((b:string,i:number)=><li><span class="accomplishment-number">0{i+1}</span><p>{b}</p></li>)}{project.mechanicalFraming&&<li><span class="accomplishment-number">0{project.bullets.length+1}</span><p>{project.mechanicalFraming}</p></li>}</ul></section>{project.images?.length>0&&<section class="mt-16"><p class="eyebrow">BUILD GALLERY</p><h2 class="heading mt-2 text-3xl font-bold">Project gallery</h2><div class="mt-5 grid gap-4 sm:grid-cols-2">{project.images.map((img:any)=><figure>{typeof img==='string'?<img class="card w-full" src={img} alt={`${project.title} project`} loading="lazy"/>:<><img class="card w-full" src={img.src} alt={img.caption||`${project.title} project`} loading="lazy"/>{img.caption&&<figcaption class="mt-2 text-sm muted">{img.caption}</figcaption>}</>}</figure>)}</div></section>}{project.whatILearned&&<section class="reflection-card mt-16"><p class="eyebrow">REFLECTION</p><h2 class="heading mt-2 text-3xl font-bold">What I learned</h2><p class="mt-4 leading-7 muted">{project.whatILearned}</p></section>}{project.whatIdDoNext&&<section class="reflection-card mt-6"><p class="eyebrow">NEXT ITERATION</p><h2 class="heading mt-2 text-3xl font-bold">What I'd do next</h2><p class="mt-4 leading-7 muted">{project.whatIdDoNext}</p></section>}<div class="mt-12 flex gap-3">{project.github&&<a class="btn btn-primary" href={project.github}>GitHub ↗</a>}{project.demoVideo&&<a class="btn" href={project.demoVideo}>Demo video ↗</a>}</div></article></BaseLayout>

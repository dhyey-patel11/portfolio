---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { portfolio } from '../data/load';
const featured=portfolio.projects.filter((p:any)=>p.featured).slice(0,3);
const latest=portfolio.experience[0];
---
<BaseLayout>
<section class="container hero-grid hero-refined py-16 sm:py-24">
  <div class="reveal hero-copy">
    <p class="eyebrow mb-4">MECHATRONICS // ROBOTICS // EMBEDDED</p>
    <h1 class="heading max-w-4xl text-5xl font-bold leading-[.98] sm:text-7xl">Dhyey Patel<span class="text-[#d2a04a]">.</span></h1>
    <p class="mt-6 max-w-3xl text-xl leading-relaxed text-[#e2e5e1]">{portfolio.person.headline}</p>
    <div class="direction-strip mt-7"><span>CURRENTLY AIMING FOR</span><p>{portfolio.person.workingToward}</p></div>
    <div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-primary" href={portfolio.links.linkedin}>LinkedIn ↗</a><a class="btn" href={portfolio.links.github}>GitHub ↗</a><a class="btn" href={portfolio.links.email}>Email</a><a class="btn" href={portfolio.links.resume}>Resume ↗</a></div>
  </div>
  <div class="hero-showcase reveal">
    <div class="home-portrait"><img src={portfolio.person.profileImage} alt="Portrait of Dhyey Patel"/></div>
    <div class="robot-stage" id="robot-stage" aria-hidden="true">
      <svg id="robot-svg" viewBox="0 0 620 470" role="presentation">
        <defs>
          <filter id="glow"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          <linearGradient id="armMetal" x1="0" x2="1"><stop offset="0" stop-color="#242a28"/><stop offset=".5" stop-color="#3a423e"/><stop offset="1" stop-color="#202523"/></linearGradient>
        </defs>
        <g id="robot-base"><path d="M385 458H535L515 423H407Z"/><rect x="425" y="390" width="72" height="48" rx="12"/></g>
        <line id="link1" class="arm-link" x1="460" y1="402" x2="340" y2="270"/>
        <line id="link2" class="arm-link" x1="340" y1="270" x2="216" y2="140"/>
        <line id="wrist-link" class="arm-link wrist-link" x1="216" y1="140" x2="150" y2="100"/>
        <g class="joint" id="joint-base"><circle cx="460" cy="402" r="34"/><circle cx="460" cy="402" r="12"/></g>
        <g class="joint" id="joint-elbow"><circle cx="340" cy="270" r="28"/><circle cx="340" cy="270" r="9"/></g>
        <g class="joint" id="joint-wrist"><circle cx="216" cy="140" r="23"/><circle cx="216" cy="140" r="7"/></g>
        <g id="gripper" transform="translate(150 100)"><rect class="tool-body" x="-17" y="-20" width="34" height="40" rx="7"/><path class="grip-finger" d="M15 -11 L43 -27 L52 -17 L29 0"/><path class="grip-finger" d="M15 11 L43 27 L52 17 L29 0"/></g>
      </svg>
    </div>
  </div>
</section>
<section class="container section-narrow py-14"><div class="section-head"><div><p class="eyebrow">PROJECTS</p><h2 class="heading mt-2 text-4xl font-bold">My projects</h2><p class="mt-3 max-w-xl muted">A few things I've designed, built, programmed, and tested.</p></div><a class="text-sm text-[#d2a04a]" href="/projects">See all projects →</a></div><div class="mt-8 grid gap-5 lg:grid-cols-3">{featured.map((p:any)=><ProjectCard project={p} compact={true}/>)}</div></section>
<section class="container section-narrow py-14"><div class="section-head"><div><p class="eyebrow">EXPERIENCE</p><h2 class="heading mt-2 text-4xl font-bold">My recent experience</h2></div><a class="text-sm text-[#d2a04a]" href="/experience">See all experience →</a></div><div class="card reveal mt-7 grid gap-6 p-6 md:grid-cols-[.75fr_1.25fr]"><div><h3 class="heading text-2xl font-bold">{latest.role}</h3><p class="mt-2 text-[#d2a04a]">{latest.company}</p><p class="mt-2 text-sm muted">{latest.location} · {latest.dates}</p></div><div class="experience-highlight"><span>RECENT WORK</span><p>{latest.bullets[0].text}</p></div></div></section>
<script is:inline>
const svg=document.getElementById('robot-svg');
if(svg && matchMedia('(pointer:fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches){
 const link1=svg.querySelector('#link1'), link2=svg.querySelector('#link2'), wristLink=svg.querySelector('#wrist-link');
 const elbow=svg.querySelector('#joint-elbow'), wrist=svg.querySelector('#joint-wrist'), gripper=svg.querySelector('#gripper');
 const B={x:460,y:402}, L1=184, L2=180, L3=82;
 let mx=innerWidth*.72,my=innerHeight*.35,raf=0,currentTool=-2.5;
 const deg=r=>r*180/Math.PI;
 const shortest=(from,to)=>from+Math.atan2(Math.sin(to-from),Math.cos(to-from));
 const setLine=(el,a,b)=>{el.setAttribute('x1',a.x);el.setAttribute('y1',a.y);el.setAttribute('x2',b.x);el.setAttribute('y2',b.y)};
 const render=()=>{
   raf=0;
   const nx=Math.max(0,Math.min(1,mx/innerWidth));
   const ny=Math.max(0,Math.min(1,my/innerHeight));
   // Keep the whole mechanism below the portrait while still responding to the full viewport.
   const tx=105 + nx*335;
   const ty=120 + ny*185;
   const dx=tx-B.x,dy=ty-B.y;
   const raw=Math.hypot(dx,dy), d=Math.max(120,Math.min(raw,L1+L2-16));
   const a=Math.atan2(dy,dx);
   const c2=Math.max(-1,Math.min(1,(d*d-L1*L1-L2*L2)/(2*L1*L2)));
   const q2=-Math.acos(c2);
   const q1=a-Math.atan2(L2*Math.sin(q2),L1+L2*Math.cos(q2));
   const E={x:B.x+L1*Math.cos(q1),y:B.y+L1*Math.sin(q1)};
   const W={x:E.x+L2*Math.cos(q1+q2),y:E.y+L2*Math.sin(q1+q2)};
   // Keep the short wrist aligned with the forearm. The old target-to-wrist
   // vector could approach zero length and make its angle numerically unstable.
   let desired=q1+q2;
   desired=shortest(currentTool,desired);
   const delta=desired-currentTool;
   const deadZone=.012;
   if(Math.abs(delta)>deadZone){
     const maxStep=.065;
     currentTool += Math.max(-maxStep,Math.min(maxStep,delta*.22));
   }
   const T={x:W.x+L3*Math.cos(currentTool),y:W.y+L3*Math.sin(currentTool)};
   setLine(link1,B,E); setLine(link2,E,W); setLine(wristLink,W,T);
   elbow.setAttribute('transform',`translate(${E.x-340} ${E.y-270})`);
   wrist.setAttribute('transform',`translate(${W.x-216} ${W.y-140})`);
   gripper.setAttribute('transform',`translate(${T.x} ${T.y}) rotate(${deg(currentTool)})`);
 };
 addEventListener('pointermove',e=>{mx=e.clientX;my=e.clientY;if(!raf)raf=requestAnimationFrame(render)},{passive:true});
 addEventListener('resize',render); render();
}
</script>
</BaseLayout>

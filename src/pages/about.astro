---
import BaseLayout from '../layouts/BaseLayout.astro'; import { portfolio } from '../data/load';
---
<BaseLayout title={`About | ${portfolio.person.name}`}><section class="container about-page py-20"><p class="eyebrow">ABOUT ME</p><h1 class="heading mt-2 text-5xl font-bold">About</h1><section class="about-intro mt-10"><div class="profile-frame"><img src={portfolio.person.profileImage} alt="Portrait of Dhyey Patel"/></div><div class="about-education"><p class="eyebrow">EDUCATION</p><h2 class="heading mt-2 text-4xl font-bold">{portfolio.education.school}</h2><p class="mt-3 text-xl">{portfolio.education.degree}</p><p class="mt-1 muted">{portfolio.education.dates}</p><p class="mt-7 max-w-xl leading-7 muted">{portfolio.person.bio}</p></div></section><section class="mt-12 grid gap-5 lg:grid-cols-2"><div class="card p-6"><p class="eyebrow">COURSEWORK // COMPLETED</p><p class="mt-4 leading-8 muted">{portfolio.education.coursework.completed.join(' · ')}</p></div><div class="card p-6"><p class="eyebrow">COURSEWORK // IN PROGRESS</p><p class="mt-4 leading-8 muted">{portfolio.education.coursework.inProgress.join(' · ')}</p></div></section><section class="personal-panel mt-12"><div><p class="eyebrow">OUTSIDE ENGINEERING</p><h2 class="heading mt-2 text-3xl font-bold">When I'm not building something.</h2><p class="mt-4 max-w-2xl text-lg leading-8 muted">{portfolio.person.personal}</p><p class="mt-4 max-w-2xl personal-invite">If you ever want to talk about something other than engineering, I'm always up for a conversation about basketball, games, or whatever you've been into lately.</p></div></section><section class="mt-16"><p class="eyebrow">ENGINEERING TOOLKIT</p><h2 class="heading mt-2 text-4xl font-bold">Skills</h2><div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{portfolio.skills.map((group:any)=><section class="card p-5"><h3 class="heading text-xl font-bold">{group.category}</h3><div class="mt-4 flex flex-wrap gap-2">{group.items.map((s:string)=><span class="tag">{s}</span>)}</div></section>)}</div></section></section></BaseLayout>

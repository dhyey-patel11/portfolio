---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { portfolio } from '../../data/load';
---
<BaseLayout title={`Experience | ${portfolio.person.name}`}><section class="container max-w-5xl py-20"><p class="eyebrow">EXPERIENCE</p><h1 class="heading mt-2 text-5xl font-bold">Co-ops & Experience</h1><p class="mt-4 max-w-2xl text-lg leading-7 muted">The teams and workplaces where I've designed, built, tested, and debugged real engineering systems.</p><div class="timeline mt-14">{portfolio.experience.map((job:any,index:number)=><article class="timeline-row reveal"><div class="timeline-code">0{index+1}</div><div><div class="experience-title-row"><div><p class="eyebrow">{job.dates}</p><h2 class="heading mt-2 text-3xl font-bold">{job.role}</h2><p class="mt-1 text-[#d2a04a] font-semibold">{job.company}</p><p class="mt-1 text-sm muted">{job.location}</p></div></div><div class="mt-4 flex flex-wrap gap-2">{job.tags.map((t:string)=><span class="tag">{t}</span>)}</div><ul class="experience-bullets mt-6">{job.bullets.map((b:any)=><li><span class="bullet-mark">›</span><span>{b.text}</span></li>)}</ul></div></article>)}</div></section></BaseLayout>

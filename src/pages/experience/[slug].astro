---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { portfolio } from '../../data/load';
export function getStaticPaths(){return portfolio.experience.filter((j:any)=>j.detailEnabled).map((job:any)=>({params:{slug:job.slug},props:{job}}));}
const { job }=Astro.props;
---
<BaseLayout title={`${job.role} at ${job.company} | ${portfolio.person.name}`}><article class="container max-w-4xl py-20"><a class="text-sm text-[#d2a04a]" href="/experience">← All experience</a><p class="eyebrow mt-10">{job.dates}</p><h1 class="heading mt-2 text-5xl font-bold">{job.role}</h1><p class="mt-3 text-xl text-[#d2a04a]">{job.company}</p><p class="mt-1 muted">{job.location}</p><div class="mt-6 flex flex-wrap gap-2">{job.tags.map((t:string)=><span class="tag">{t}</span>)}</div>{job.overview&&<p class="mt-10 leading-7 muted">{job.overview}</p>}<section class="mt-10"><h2 class="heading text-2xl font-bold">Highlights</h2><ul class="prose-list mt-4 leading-7">{job.bullets.map((b:any)=><li>{b.text}</li>)}</ul></section>{job.whatILearned&&<section class="mt-10"><h2 class="heading text-2xl font-bold">What I learned</h2><p class="mt-3 leading-7 muted">{job.whatILearned}</p></section>}</article></BaseLayout>

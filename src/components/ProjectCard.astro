---
const { project, compact = false } = Astro.props;
---
<article class="project-card card group flex h-full flex-col overflow-hidden">
  <a class="project-visual" href={`/projects/${project.slug}`} aria-label={`View ${project.title}`}>
    {project.heroImage ? <img src={project.heroImage} alt={`${project.title} project`} loading="lazy" /> : <div class="visual-placeholder"><span class="scan-line"></span><span>PROJECT // {project.slug.toUpperCase().replaceAll('-', '_')}</span><div class="node-map"><i></i><i></i><i></i></div></div>}
  </a>
  <div class:list={["flex flex-1 flex-col", compact ? "p-5" : "p-6"]}>
    <p class="eyebrow mb-2">{project.dates}</p>
    <h3 class="heading text-2xl font-bold"><a href={`/projects/${project.slug}`}>{project.title}</a></h3>
    <p class="mt-3 text-sm leading-6 muted">{project.summary}</p>
    <div class="mt-5 flex flex-wrap gap-2">{project.tags.slice(0, compact ? 4 : 5).map((tag:string)=><span class="tag">{tag}</span>)}</div>
    <a class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-[#d2a04a]" href={`/projects/${project.slug}`}>View project <span aria-hidden="true">→</span></a>
  </div>
</article>
